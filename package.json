{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.dev",
    "dev:localnetwork": "nuxt dev --host 0.0.0.0 --dotenv .env.dev",
    "lint": "eslint .",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.dev -- prisma migrate dev",
    "cli": "cd cli && pnpm serve",
    "prisma:migrate:dev": "dotenv -e .env.dev -- prisma migrate deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/eslint": "^0.3.13",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@primevue/themes": "^4.0.4",
    "@prisma/client": "5.18.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "argon2": "^0.40.3",
    "dotenv-cli": "^7.4.2",
    "nuxt": "^3.12.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.0.4",
    "tailwindcss-primeui": "^0.3.4",
    "trpc-nuxt": "^0.10.22",
    "vue": "^3.4.37",
    "vue-router": "^4.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@primevue/nuxt-module": "^4.0.4",
    "@vueuse/core": "^10.11.1",
    "@vueuse/nuxt": "^10.11.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "prisma": "^5.18.0",
    "sass": "^1.77.8"
  },
  "lint-staged": {
    "*": "eslint"
  },
  "packageManager": "pnpm@8.11.0+sha1.01bf39424f1008f29012bbae851d2acb8a20a0d0"
}
